<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.LoginpageController">
   <children>
      <Label alignment="CENTER" layoutX="157.0" layoutY="14.0" prefHeight="66.0" prefWidth="267.0" text="Login page" textFill="#973fd4">
         <font>
            <Font name="Bookman Old Style Bold" size="39.0" />
         </font>
      </Label>
      <Label alignment="CENTER" layoutX="107.0" layoutY="179.0" prefHeight="34.0" prefWidth="149.0" text="password :">
         <font>
            <Font size="17.0" />
         </font>
      </Label>
      <Label alignment="CENTER" layoutX="99.0" layoutY="124.0" prefHeight="35.0" prefWidth="158.0" text="User Name :">
         <font>
            <Font size="17.0" />
         </font>
      </Label>
      <PasswordField fx:id="txtPassword" layoutX="237.0" layoutY="183.0" prefHeight="26.0" prefWidth="186.0" />
      <TextField fx:id="txtUserName" layoutX="237.0" layoutY="129.0" prefHeight="26.0" prefWidth="186.0" />
      <Button fx:id="btnLogin" layoutX="211.0" layoutY="255.0" mnemonicParsing="false" onAction="#btnLoginOnAction" prefHeight="38.0" prefWidth="128.0" text="Login">
         <font>
            <Font size="19.0" />
         </font>
      </Button>
      <Button fx:id="btnReset" layoutX="519.0" layoutY="351.0" mnemonicParsing="false" onAction="#btnRestOnAction" prefHeight="26.0" prefWidth="56.0" text="Reset">
         <font>
            <Font size="13.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
